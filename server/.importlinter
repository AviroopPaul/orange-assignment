[importlinter]
root_packages =
    app
    mock_provider
include_external_packages = True

[importlinter:contract:mock-is-external]
name = the app reaches the mock provider only over HTTP
type = forbidden
source_modules = app
forbidden_modules = mock_provider

[importlinter:contract:mock-knows-no-domain]
name = the mock provider knows nothing about our domains
type = forbidden
source_modules = mock_provider
forbidden_modules = app.domains

[importlinter:contract:core-is-independent]
name = core does not import domains
type = forbidden
source_modules = app.core
forbidden_modules = app.domains

[importlinter:contract:adk-stays-in-agent]
name = only the agent domain imports ADK
type = forbidden
source_modules =
    app.core
    app.domains.bookings
    app.domains.chat
    app.domains.gateway
    app.domains.jobs
    app.domains.notifications
    app.domains.system
    app.domains.tracing
    app.domains.workflow
forbidden_modules =
    google
    app.domains.agent

[importlinter:contract:gateway-is-below-chat]
name = the gateway does not know about chat, the agent or the workflow
type = forbidden
source_modules = app.domains.gateway
forbidden_modules =
    app.domains.agent
    app.domains.bookings
    app.domains.chat
    app.domains.notifications
    app.domains.system
    app.domains.jobs
    app.domains.workflow

[importlinter:contract:jobs-are-generic]
name = the jobs domain knows no other domain
type = forbidden
source_modules = app.domains.jobs
forbidden_modules =
    app.domains.agent
    app.domains.bookings
    app.domains.chat
    app.domains.gateway
    app.domains.notifications
    app.domains.system
    app.domains.tracing

[importlinter:contract:bookings-are-below-the-model]
name = bookings know nothing of chat or the agent
type = forbidden
source_modules =
    app.domains.bookings
    app.domains.notifications
forbidden_modules =
    app.domains.agent
    app.domains.chat
